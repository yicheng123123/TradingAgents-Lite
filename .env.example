# Reference values for WSL shell configuration. The application reads environment variables.
# Set TALITE_API_KEY in the shell; never commit a real key.
TALITE_API_KEY=
TALITE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TALITE_MODEL=glm-5.3

# Optional declared User-Agent for SEC EDGAR acquisition.
TALITE_SEC_USER_AGENT=
